# Django settings
SECRET_KEY=django-insecure-dnd-atarax-development-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Engine: 'postgresql' (výchozí) nebo 'sqlite' (např. pro lokální offline vývoj)
DB_ENGINE=postgresql

# PostgreSQL konfigurace pro váš vlastní server
# Zde vyplňte IP adresu nebo doménu vašeho serveru (např. 192.168.1.50 nebo db.vase-domena.cz)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dnd_atarax_db
DB_USER=postgres
DB_PASSWORD=postgres
